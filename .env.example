# lnms-invoice 配置文件示例
# 复制为 .env(.env 已加入 .gitignore)后填值

# 主配置文件路径(可选;默认 config/default.toml)
# LNMS_INVOICE_CONFIG=/etc/lnms-invoice/lnms-invoice.toml

# LibreNMS 凭据(开发期用;生产期走 systemd LoadCredentialEncrypted,**绝不**写到这里)
# LNMS_API_TOKEN=

# 数据库路径(可选;覆盖 config 里的 [database].path)
# LNMS_INVOICE_DB=/var/lib/lnms-invoice/db.sqlite

# 输出根目录(可选;覆盖 [output].root)
# LNMS_INVOICE_OUTPUT=/var/lib/lnms-invoice/output

# 日志级别
# RUST_LOG=info,lnms_invoice=debug
